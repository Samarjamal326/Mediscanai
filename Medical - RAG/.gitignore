# .gitignore for Medical RAG Project

# Environment variables (NEVER commit API keys)
.env

# Python cache
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
ENV/

# HuggingFace model cache (large files, auto-downloaded)
.cache/

# Old TypeScript / Node artifacts
node_modules/
*.ts
dist/
build/
*.js

# Pinecone / vector store local files
vector-store/

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db
